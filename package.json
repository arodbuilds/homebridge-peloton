{
  "name": "homebridge-peloton",
  "displayName": "Peloton",
  "type": "module",
  "version": "1.0.0-beta.1",
  "description": "Peloton workouts as HomeKit sensors for Homebridge automations",
  "author": "Alex Rodriguez (https://alex-rodriguez.com)",
  "license": "Apache-2.0",
  "homepage": "https://github.com/arodbuilds/homebridge-peloton#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/arodbuilds/homebridge-peloton.git"
  },
  "bugs": {
    "url": "https://github.com/arodbuilds/homebridge-peloton/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "peloton",
    "homekit",
    "workout"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "homebridge-ui/public",
    "homebridge-ui/server.js",
    "config.schema.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm run lint && npm run build",
    "watch": "npm run build && npm link && nodemon"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@homebridge/hap-nodejs": "2.2.2",
    "@types/node": "^22.20.2",
    "eslint": "^10.9.0",
    "homebridge": "^2.4.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
